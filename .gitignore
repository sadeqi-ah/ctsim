# Rust build artifacts
/target

# Simulator output (regenerated by the figure scripts)
/results
/sweep_results

# Generated binary figures (textual tables like *.tex and *.csv are tracked)
*.png
*.pdf
*.svg
*.dot

# Fingerprints written by tools/regen_figures.py (MANIFEST.sha256 is tracked; JSON ignored)
/MANIFEST.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# Local agent / tooling state — never belongs in the public history
.hermes/
